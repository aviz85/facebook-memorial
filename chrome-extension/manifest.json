{
  "manifest_version": 3,
  "name": "Facebook Memorial Feed",
  "version": "1.0.0",
  "description": "מחליף את הפיד בפייסבוק בתמונות זיכרון של הנופלים ביום הזיכרון לחללי מערכות ישראל",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Facebook Memorial Feed"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["contentScript.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["activeTab", "storage", "tabs", "scripting"],
  "host_permissions": [
    "*://*.supabase.co/*",
    "*://*.jsdelivr.net/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
} 